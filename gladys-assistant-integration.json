  "actions": [
    {
      "key": "test_voice",
      "label": {
        "en": "Test the voice",
        "fr": "Tester la voix"
      },
      "description": {
        "en": "Asks Polly for a short sentence (about 50 billed characters) with the saved settings and says how it went. Nothing is played.",
        "fr": "Demande à Polly une courte phrase (environ 50 caractères facturés) avec les réglages enregistrés et dit comment cela s’est passé. Rien n’est joué."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "language",
          "type": "select",
          "label": {
            "en": "Voice to test",
            "fr": "Voix à tester"
          },
          "required": false,
