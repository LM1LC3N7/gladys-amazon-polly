{
  "manifest_version": 1,
  "type": "tts",
  "name": "Amazon Polly",
  "description": {
    "en": "Amazon Polly voices for Gladys announcements, with your own AWS account.",
    "fr": "Voix Amazon Polly pour les annonces de Gladys, avec votre propre compte AWS."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-amazon-polly:0.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-amazon-polly/main/cover.png",
  "categories": ["assistants"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your AWS keys",
        "fr": "Vos clés AWS"
      },
      "description": {
        "en": "Amazon Polly is billed to your own AWS account, per character spoken. Create an IAM user allowed only polly:SynthesizeSpeech (the documentation gives the policy) and enter its access key here. The standard engine is the default: the cheapest one.",
        "fr": "Amazon Polly est facturé sur votre propre compte AWS, au caractère prononcé. Créez un utilisateur IAM autorisé seulement à polly:SynthesizeSpeech (la documentation donne la stratégie) et saisissez sa clé d’accès ici. Le moteur standard est celui par défaut : le moins cher."
      },
      "links": [
        {
          "url": "https://aws.amazon.com/polly/pricing/",
          "label": {
            "en": "Amazon Polly prices",
            "fr": "Tarifs d’Amazon Polly"
          }
        },
        {
          "url": "https://docs.aws.amazon.com/polly/latest/dg/available-voices.html",
          "label": {
            "en": "Polly voices and engines",
            "fr": "Voix et moteurs de Polly"
          }
        }
      ]
    },
    {
      "key": "access_key_id",
      "type": "string",
      "label": {
        "en": "Access key ID",
        "fr": "Identifiant de clé d’accès"
      },
      "description": {
        "en": "The access key ID of the IAM user (AKIA… ).",
        "fr": "L’identifiant de clé d’accès de l’utilisateur IAM (AKIA… )."
      },
      "placeholder": {
        "en": "e.g. AKIAIOSFODNN7EXAMPLE",
        "fr": "ex. AKIAIOSFODNN7EXAMPLE"
      },
      "required": true
    },
    {
      "key": "secret_access_key",
      "type": "secret",
      "label": {
        "en": "Secret access key",
        "fr": "Clé d’accès secrète"
      },
      "description": {
        "en": "The secret access key shown once by AWS when the key was created. Kept by Gladys in its database, never shown again, sent only to Amazon Web Services (it signs the requests: only the signature travels, not the key itself).",
        "fr": "La clé d’accès secrète affichée une seule fois par AWS à la création de la clé. Gardée par Gladys dans sa base, jamais réaffichée, envoyée seulement à Amazon Web Services (elle signe les requêtes : seule la signature circule, pas la clé elle-même)."
      },
      "required": true
    },
    {
      "key": "region",
      "type": "select",
      "label": {
        "en": "AWS region",
        "fr": "Région AWS"
      },
      "description": {
        "en": "Where Polly runs. Not every engine exists in every region: eu-west-1 (Ireland) has the standard and neural voices.",
        "fr": "Où Polly tourne. Tous les moteurs n’existent pas dans toutes les régions : eu-west-1 (Irlande) a les voix standard et neuronales."
      },
      "required": false,
      "default": "eu-west-1",
      "options": [
        {
          "value": "us-east-1",
          "label": {
            "en": "us-east-1",
            "fr": "us-east-1"
          }
        },
        {
          "value": "us-east-2",
          "label": {
            "en": "us-east-2",
            "fr": "us-east-2"
          }
        },
        {
