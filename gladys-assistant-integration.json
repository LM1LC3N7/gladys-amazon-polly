    {
      "key": "engine",
      "type": "select",
      "label": {
        "en": "Voice engine",
        "fr": "Moteur de voix"
      },
      "description": {
        "en": "Standard is the cheapest; neural, generative and long-form sound more natural and cost more per character (see the prices). Not every voice has every engine: Polly then says so.",
        "fr": "Standard est le moins cher ; neuronal, génératif et long format sonnent plus naturel et coûtent plus cher au caractère (voir les tarifs). Toutes les voix n’ont pas tous les moteurs : Polly le dit alors."
      },
      "required": false,
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": {
            "en": "Standard (cheapest)",
            "fr": "Standard (le moins cher)"
          }
        },
        {
          "value": "neural",
          "label": {
