{
  "name": "gladys-amazon-polly",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon Polly voices for Gladys Assistant: a text-to-speech provider (standard voices by default) with your own AWS keys.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "mutants": "node scripts/mutants.mjs",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-amazon-polly.git"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1166.0",
    "@gladysassistant/integration-sdk": "^0.16.0",
    "@smithy/node-http-handler": "^4.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
